{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craighsieh.github.io/bilingual-learning-assistant-site/protocol/dualcue-reader-v1.schema.json",
  "$comment": "Canonical source lives in the DualCue extension repository; the public-site copy is generated.",
  "title": "DualCueReaderBridgeV1",
  "type": "object",
  "required": [
    "protocolVersion",
    "type",
    "requestId"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "type": {
      "enum": [
        "hello",
        "import-url",
        "resume-job",
        "start-local-translation",
        "prepare-byok",
        "cancel",
        "hello-ack",
        "import-status",
        "document-ready",
        "byok-confirmation-required",
        "batch-results",
        "complete",
        "error"
      ]
    },
    "requestId": {
      "$ref": "#/$defs/opaqueId"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "targetLanguage": {
      "enum": [
        "zh-Hant",
        "zh-Hans",
        "ja",
        "ko"
      ]
    },
    "sourceKind": {
      "enum": [
        "article",
        "youtube",
        "bilibili"
      ]
    },
    "importStatus": {
      "enum": [
        "opening-source",
        "waiting-authorization",
        "extracting"
      ]
    },
    "errorCode": {
      "enum": [
        "invalid-request",
        "unsupported-url",
        "authorization-required",
        "no-readable-content",
        "captions-unavailable",
        "connection-lost",
        "translation-failed"
      ]
    },
    "readerSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaqueId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "readerDocument": {
      "type": "object",
      "x-dualcue-totalCharacters": 500000,
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "url",
        "title",
        "sourceLanguage",
        "segments"
      ],
      "properties": {
        "sourceKind": {
          "$ref": "#/$defs/sourceKind"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sourceLanguage": {
          "const": "en"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": {
            "$ref": "#/$defs/readerSegment"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "hello"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "resume-job"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        },
        "targetLanguage": {
          "$ref": "#/$defs/targetLanguage"
        }
      },
      "required": [
        "type",
        "jobId",
        "targetLanguage"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "import-url"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "targetLanguage": {
          "$ref": "#/$defs/targetLanguage"
        }
      },
      "required": [
        "type",
        "url",
        "targetLanguage"
      ]
    },
    {
      "properties": {
        "type": {
          "enum": [
            "start-local-translation",
            "prepare-byok",
            "cancel"
          ]
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "required": [
        "type",
        "jobId"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "hello-ack"
        },
        "extensionVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localTranslator",
            "byokConfigured"
          ],
          "properties": {
            "localTranslator": {
              "type": "boolean"
            },
            "byokConfigured": {
              "type": "boolean"
            },
            "provider": {
              "type": "string",
              "maxLength": 100
            },
            "model": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      },
      "required": [
        "type",
        "extensionVersion",
        "capabilities"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "import-status"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        },
        "status": {
          "$ref": "#/$defs/importStatus"
        }
      },
      "required": [
        "type",
        "jobId",
        "status"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "document-ready"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        },
        "document": {
          "$ref": "#/$defs/readerDocument"
        }
      },
      "required": [
        "type",
        "jobId",
        "document"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "byok-confirmation-required"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "targetLanguage": {
          "$ref": "#/$defs/targetLanguage"
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        },
        "characterCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000
        }
      },
      "required": [
        "type",
        "jobId",
        "provider",
        "model",
        "targetLanguage",
        "segmentCount",
        "characterCount"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "batch-results"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        },
        "translations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/opaqueId"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        }
      },
      "required": [
        "type",
        "jobId",
        "translations",
        "completed",
        "total"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "complete"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "required": [
        "type",
        "jobId"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "error"
        },
        "jobId": {
          "$ref": "#/$defs/opaqueId"
        },
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recoverable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "jobId",
        "code",
        "message",
        "recoverable"
      ]
    }
  ]
}
